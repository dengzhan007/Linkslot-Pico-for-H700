From 04298e1493de4dc0ffb9033fe57799b2618c45c9 Mon Sep 17 00:00:00 2001
From: dengzhan007 <42714657+dengzhan007@users.noreply.github.com>
Date: Wed, 25 Nov 2026 19:15:18 +0800
Subject: [PATCH 2/2] fix(fdt): write JSON output with LF so hashes are stable
 across hosts

Pathlib.write_text defaulted to the platform newline, so the same DTB
produced 39887-byte CRLF JSON on Windows and 38537-byte LF JSON elsewhere
and any recorded SHA-256 only described one of them.
---
 tools/inspect_h700_fdt.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/tools/inspect_h700_fdt.py b/tools/inspect_h700_fdt.py
index 4ea206b..54239bf 100644
--- a/tools/inspect_h700_fdt.py
+++ b/tools/inspect_h700_fdt.py
@@ -645,7 +645,7 @@ def main() -> int:
     rendered = json.dumps(reports if len(reports) > 1 else reports[0], indent=2, sort_keys=True) + "\n"
     if args.output:
         args.output.parent.mkdir(parents=True, exist_ok=True)
-        args.output.write_text(rendered, encoding="utf-8")
+        args.output.write_text(rendered, encoding="utf-8", newline="\n")
     else:
         print(rendered, end="")
     return 0
-- 
2.55.0.windows.3

